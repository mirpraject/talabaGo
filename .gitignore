# ==============================================================================
# TalabaGo (StudentHUB) — Git Ignore Rules
# ==============================================================================

# Environment files & Secrets (CRITICAL FOR SECURITY)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Database files & SQLite (MUST NOT BE PUSHED TO GIT)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
studenthub.db*
backend/studenthub.db*

# User Uploaded Content
backend/uploads/*
!backend/uploads/.gitkeep
uploads/

# Python Dependencies & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
/lib/
/lib64/
!src/lib/
!src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
# Temporary conversion scripts
add_kr*.py
scratch_*.py

# Node & Next.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Logs
*.log
logs/

# IDE & Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
.docker/