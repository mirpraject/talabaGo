# ==============================================================================
# TalabaGo — Root Environment Configuration (.env.example)
# Haqiqiy serverga o'rnatishda: cp .env.example .env
# ==============================================================================

# 1. Database Configuration (PostgreSQL for Docker / Single Server)
POSTGRES_USER=talabago
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=talabago
DATABASE_URL=postgresql://talabago:your_secure_postgres_password_here@db:5432/talabago

# 2. JWT Security & Authentication
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. AI Features (Google Gemini / OpenAI API)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-2.5-flash

# 4. Frontend Configuration
# Nginx orqali bitta serverda ishlatilganda bo'sh qoldiriladi (nisbiy so'rovlar uchun)
NEXT_PUBLIC_API_URL=
