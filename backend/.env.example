# ==============================================================================
# TalabaGo Backend Environment Configuration (.env.example)
# ==============================================================================

# Database URL:
# Mahalliy SQLite uchun:
DATABASE_URL=sqlite:///studenthub.db
# PostgreSQL server uchun:
# DATABASE_URL=postgresql://talabago:password@localhost:5432/talabago

# Security:
SECRET_KEY=change-this-jwt-secret-key-in-production-random-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Gemini API yoki OpenAI API):
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-2.5-flash